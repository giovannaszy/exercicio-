programa
{
	
	funcao inicio()
	{
		escreva("\n Olá Mundo \n")
		soma(13,22)
		dizerNome("\n Giovanna \n")
		dizerNome(" \n Manu \n ")
	}

	funcao soma(inteiro n1, inteiro n2){
		inteiro resultado = n1 + n2
		escreva(resultado)
		
	}

	funcao dizerNome(cadeia nome){
		escreva("\n Ola ", nome, "Seja Bem-vindo! \n")
		
	}
}
