programa
{
	
	funcao inicio()
	{
		escreva("Olá Mundo \n")
		escreva("-----------------------------------------\n")
	     escreva("Conversao de Centimetro para Metros \n")
	     escreva("-----------------------------------------\n")
		conversao (1000.0)
	}
 
	 funcao conversao (real cm){
	 real resultado = cm / 100
	 escreva(resultado)
	
		
	}
}
