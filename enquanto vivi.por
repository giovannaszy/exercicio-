programa
{
	
	funcao inicio()
	{
		inteiro contador = 1, n1 = 1, soma = 0
         
          
          enquanto (contador <= 10) {
          escreva("Digite 10 numeros \n")
          leia(n1)
          soma = soma + n1
          contador ++
			
		}
		escreva("a soma destes numeros foi de: \n", soma, "\n")
	}
}
